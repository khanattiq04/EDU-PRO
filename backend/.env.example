# Server
PORT=4000

# MySQL connection.
# Hostinger: hPanel -> Databases -> MySQL Databases gives you these values.
# The database name is prefixed with your account id, e.g. u123456789_danistan.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=danistan_network
DB_POOL_SIZE=10

# Comma-separated browser origins allowed to call the API (scheme + hostname, no path).
# Include every deployed frontend hostname, including test/staging subdomains.
CORS_ORIGIN=https://test.desertsafaridunes.com

# Admin panel credentials - change these before going live.
ADMIN_EMAIL=admin@danistan.network
ADMIN_PASSWORD=ChangeThisPassword!

# Secrets used to sign sessions and encrypt CNIC values.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DANISTAN_SESSION_KEY=replace-with-a-long-random-string
DANISTAN_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Traffic & stability (all optional; defaults shown) -----------------------
# Worker processes. 1 = single process (Hostinger shared/Business plans).
# On a VPS/Cloud plan set it to the number of CPU cores; a crashed worker is
# restarted automatically within 1 second.
WEB_CONCURRENCY=1
# MySQL connections per worker. Keep WEB_CONCURRENCY x DB_POOL_SIZE below your
# MySQL max_connections (often 150; Hostinger shared plans may allow fewer).
DB_POOL_SIZE=20
# Requests per minute: per logged-in user, and per IP for anonymous traffic.
RATE_LIMIT_PER_USER=300
RATE_LIMIT_PER_IP=1200
# Above this many simultaneous requests new ones get "busy, retry" (the website retries automatically).
MAX_IN_FLIGHT=1500
# Where downloaded course files are cached on disk (default: system temp folder).
# FILE_CACHE_DIR=
